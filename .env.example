# Variables de entorno de PhishGuard-AI.
# Copiar a .env y llenar con valores reales. NUNCA commitear .env.

# Obligatorio
GOOGLE_API_KEY=
MONGODB_ATLAS_CLUSTER_URI=

# Opcional — Jira (tickets de alerta)
JIRA_INSTANCE_URL=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=

# Opcional — VirusTotal (reputación de hashes/URLs/dominios/IPs)
VT_API_KEY=

# Operación
DRY_RUN=true
