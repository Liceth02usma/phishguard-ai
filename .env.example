# ============================================================
# PhishGuard-AI — Configuración de entorno
# ============================================================
# Copiar a .env y llenar los valores reales.
# NUNCA commitear .env con claves reales (FR-009).

# --- Credenciales principales ---

# Google Gemini (requerida si LLM_PROVEEDOR=gemini)
GOOGLE_API_KEY=

# MongoDB Atlas (requerida para persistencia, cache VT, contador LLM)
MONGODB_ATLAS_CLUSTER_URI=

# VirusTotal API v3 (requerida para reputación de URLs/dominios/adjuntos)
VT_API_KEY=

# Jira (requerida para notificación automática al SOC)
JIRA_INSTANCE_URL=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=

# Groq (requerida si LLM_PROVEEDOR=groq)
GROQ_API_KEY=

# HCTI (htmlcsstoimage) — genera screenshots de correos para tickets Jira
# Opcional: si no está configurado, los tickets se crean sin evidencia visual.
HCTI_API_ID=
HCTI_API_KEY=

# --- Acciones (spec 010) ---

# DRY_RUN=true → acciones se simulan sin ejecutar (default para desarrollo)
# DRY_RUN=false → acciones reales: etiquetar Gmail + crear tickets Jira
ACCIONES_DRY_RUN=true

# --- API REST (spec 012) ---

# Clave de autenticación para la API (X-API-Key header)
API_KEY=
# Orígenes CORS permitidos (separados por coma)
CORS_ORIGINS=

# --- Agente de IA sin estado (spec 009, módulo M07) ---

# Proveedor LLM: simulado (cero red), gemini (default), groq
LLM_PROVEEDOR=gemini
# Modelo LLM (default por proveedor: gemini=gemini-2.5-flash-lite, groq=llama-3.3-70b-versatile)
LLM_MODELO=
# Tope diario de llamadas al modelo (default: 100)
LLM_MAX_DIARIO=100

# --- Configuración de banderas de cabeceras y remitente (spec 003, módulo M03) ---
# Listas de valores separados por coma, en minúsculas y sin espacios.
# Defaults documentados en specs/003-banderas-cabeceras/research.md (D9).

# authserv-id de la pasarela de correo propia: solo sus Authentication-Results
# se confían (FR-001). Vacío = ninguna cabecera es de confianza (conservador).
# Ejemplo: AUTHSERV_ID=mail.ucaldas.edu.co
AUTHSERV_ID=

# Dominios propios de la organización (comparación por dominio organizacional).
# Ejemplo: DOMINIOS_PROPIOS=ucaldas.edu.co,mail.ucaldas.edu.co
DOMINIOS_PROPIOS=

# Marcas protegidas para detectar dominios parecidos y nombres que suplantan.
# Ejemplo: MARCAS_PROTEGIDAS=ucaldas,universidad de caldas
MARCAS_PROTEGIDAS=

# Nombres de contactos internos conocidos (para NOMBRE_SUPLANTA).
# Ejemplo: CONTACTOS_INTERNOS=liceth usma,soporte ti
CONTACTOS_INTERNOS=

# Términos que aparentan ser internos (para REMITENTE_EXTERNO_COMO_INTERNO).
# Ejemplo: TERMINOS_INTERNOS=soporte,ti,helpdesk,admin
TERMINOS_INTERNOS=

# Dominios de correo gratuito (para REPLY_TO_GRATUITO). Si se deja vacío se usa
# la lista por defecto (gmail, hotmail, outlook, yahoo, live, icloud, proton).
DOMINIOS_GRATUITOS=

# Proveedores de envío cuyo Message-ID usa otro dominio (evita MESSAGE_ID_DISTINTO).
# Ejemplo: PROVEEDORES_ENVIO=sendgrid.net,mailgun.org,amazonses.com
PROVEEDORES_ENVIO=

# --- Análisis y expansión de URLs (M04b, spec 004) ---
# Listas separadas por coma. Los defaults validados están en research.md D8.

# Acortadores de URL conocidos (se expanden antes de evaluar).
# Default: bit.ly,t.co,tinyurl.com,ow.ly,is.gd,shorte.st,rb.gy,cutt.ly
ACORTADORES=

# TLD de riesgo alto (ej: .xyz, .tk, .ml — baratos, usados en phishing).
# Default: xyz,tk,ml,ga,cf,gq,pw,top,club,work,biz,info,online,site,live
TLD_RIESGO=

# Parámetros de tracking en URLs (se eliminan antes de comparar).
# Default: utm_source,utm_medium,utm_campaign,utm_content,utm_term,fbclid,gclid
PARAMETROS_TRACKING=

# Parámetros sensibles en URLs (password, token, etc. — bandera de riesgo).
# Default: password,passwd,token,secret,key,api_key,access_token,auth,credential
PARAMETROS_SENSIBLES=

# Máximo de subdominios antes de considerar sospechoso.
# Default: 5
URL_SUBDOMINIOS_MAX=

# --- Análisis de adjuntos (spec 005, módulo M05) ---
# Listas separadas por coma, minúsculas, sin punto inicial. Defaults del M05.

# Extensiones de riesgo alto (ejecutables, scripts, etc.)
ADJ_EXTENSIONES_RIESGO=exe,scr,com,msi,dll,js,vbs,ps1,bat,cmd,hta,wsf,lnk,iso,img,vhd
# Extensiones HTML (pueden contener phishing embebido)
ADJ_EXTENSIONES_HTML=html,htm,svg
# Extensiones de documento (se analizan macros OLE2)
ADJ_EXTENSIONES_DOCUMENTO=pdf,doc,docx,xls,xlsx,ppt,pptx,odt,ods,odp,txt,csv,jpg,jpeg,png,gif
# Límites de seguridad para ZIPs
ADJ_LIMITE_ENTRADAS_ZIP=100
ADJ_LIMITE_DESCOMPRIMIDO_ZIP=104857600
ADJ_RATIO_MAXIMO_ZIP=100

# --- VirusTotal API v3 (spec 006, módulo M06) ---
# La API pública gratuita (VT_TIER=public) es SOLO para demostración: su uso en
# productos o servicios comerciales no está permitido por los términos de
# VirusTotal (FR-002). Para oferta comercial se requiere licencia Premium.
# La clave VT_API_KEY va SOLO en el entorno real (.env), nunca aquí ni en logs (FR-009).

VT_TIER=public
VT_RPM=4
VT_DAILY=500
VT_MAX_POR_CORREO=10
VT_UPLOAD_UNKNOWN=false
VT_SUBMIT_UNKNOWN_URLS=false
VT_UMBRAL_MALICIOSA=3
VT_UMBRAL_SOSPECHOSA=3
VT_UMBRAL_LIMPIA=20

# --- Scoring con clasificador lineal (spec 007, módulo M10) ---

# Dominios de proveedores de confianza (no activan genes 0/28).
# Ejemplo: DOMINIOS_PROVEEDORES_CONFIANZA=microsoft.com,google.com,amazon.com
DOMINIOS_PROVEEDORES_CONFIANZA=

# Ruta al archivo JSON del modelo entrenado.
# Default: data/modelo/clasificador_v1.json
# Este archivo contiene los 32 pesos del clasificador lineal entrenado con
# 100correos.csv (correos de phishing en español). Se genera con:
#   python scripts/entrenar_clasificador.py
RUTA_MODELO=
