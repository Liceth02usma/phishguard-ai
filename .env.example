# Configuracion de banderas de cabeceras y remitente (spec 003, modulo M03).
# Listas de valores separados por coma, en minusculas y sin espacios.
# Defaults documentados en specs/003-banderas-cabeceras/research.md (D9).

# authserv-id de la pasarela de correo propia: solo sus Authentication-Results
# se confian (FR-001). Vacio = ninguna cabecera es de confianza (conservador).
AUTHSERV_ID=

# Dominios propios de la organizacion (comparacion por dominio organizacional).
DOMINIOS_PROPIOS=

# Marcas protegidas para detectar dominios parecidos y nombres que suplantan.
MARCAS_PROTEGIDAS=

# Nombres de contactos internos conocidos (para NOMBRE_SUPLANTA).
CONTACTOS_INTERNOS=

# Terminos que aparentan ser internos (para REMITENTE_EXTERNO_COMO_INTERNO).
TERMINOS_INTERNOS=

# Dominios de correo gratuito (para REPLY_TO_GRATUITO). Si se deja vacio se usa
# la lista por defecto (gmail, hotmail, outlook, yahoo, live, icloud, proton).
DOMINIOS_GRATUITOS=

# Proveedores de envio cuyo Message-ID usa otro dominio (evita MESSAGE_ID_DISTINTO).
PROVEEDORES_ENVIO=

# Operación
DRY_RUN=true

# Opcional -- Analisis y expansion de URLs (M04b, spec 004)
# Listas separadas por coma. Los defaults validados estan en research.md D8.
ACORTADORES=
TLD_RIESGO=
PARAMETROS_TRACKING=
PARAMETROS_SENSIBLES=
URL_SUBDOMINIOS_MAX=

# Análisis de adjuntos (spec 005, módulo M05)
# Listas separadas por coma, minúsculas, sin punto inicial. Defaults del M05.
ADJ_EXTENSIONES_RIESGO=exe,scr,com,msi,dll,js,vbs,ps1,bat,cmd,hta,wsf,lnk,iso,img,vhd
ADJ_EXTENSIONES_HTML=html,htm,svg
ADJ_EXTENSIONES_DOCUMENTO=pdf,doc,docx,xls,xlsx,ppt,pptx,odt,ods,odp,txt,csv,jpg,jpeg,png,gif
ADJ_LIMITE_ENTRADAS_ZIP=100
ADJ_LIMITE_DESCOMPRIMIDO_ZIP=104857600
ADJ_RATIO_MAXIMO_ZIP=100
# Integracion VirusTotal API v3 (spec 006, modulo M06).
# La API publica gratuita (VT_TIER=public) es SOLO para demostracion: su uso en
# productos o servicios comerciales no esta permitido por los terminos de
# VirusTotal (FR-002). Para oferta comercial se requiere licencia Premium.
# La clave VT_API_KEY va SOLO en el entorno real (.env), nunca aqui ni en logs (FR-009).
VT_TIER=public
VT_RPM=4
VT_DAILY=500
VT_MAX_POR_CORREO=10
VT_UPLOAD_UNKNOWN=false
VT_SUBMIT_UNKNOWN_URLS=false
VT_UMBRAL_MALICIOSA=3
VT_UMBRAL_SOSPECHOSA=3
VT_UMBRAL_LIMPIA=20

# Scoring con clasificador lineal (spec 007, módulo M10)
# Dominios de proveedores de confianza (no activan genes 0/28). Default en research D5.
DOMINIOS_PROVEEDORES_CONFIANZA=
# Ruta al archivo JSON del modelo entrenado. Default: data/modelo/clasificador_v1.json
RUTA_MODELO=
